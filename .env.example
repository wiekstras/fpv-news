# --- Core -------------------------------------------------------------------
# Postgres connection string. Local: `docker compose up -d` gives you this one.
DATABASE_URL=postgres://fpv:fpv@localhost:5432/fpv
# Long random string used to sign auth tokens: `openssl rand -hex 32`
PAYLOAD_SECRET=change-me
# Public base URL, no trailing slash (emails, sitemap, OG tags). Read at runtime.
# On Railway you can leave it empty: the service's generated domain (RAILWAY_PUBLIC_DOMAIN) is used.
# Set it once you add a custom domain.
SERVER_URL=http://localhost:3000
# On first boot with an empty database, starter news sources and an example build are created.
# Set to false to skip.
SEED_ON_EMPTY=true

# --- Email (Resend) -----------------------------------------------------------
# Leave empty locally: emails are then printed to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=hello@example.com
EMAIL_FROM_NAME=FPV News

# --- Media storage (Railway bucket / any S3-compatible) -------------------------
# Leave S3_BUCKET empty to store uploads on local disk in ./media.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to true if your provider needs path-style URLs
S3_FORCE_PATH_STYLE=false

# --- News summaries (Claude API) -----------------------------------------------
# Only used when "Generate summaries with Claude" is ticked in Settings → News.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. Set to claude-haiku-5-5 for a much cheaper option.
ANTHROPIC_MODEL=

# --- Deals radar -------------------------------------------------------------------
# eBay Browse API keys (developer.ebay.com → Application keys, Production).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional contact address added to the deals bot's user agent.
DEALS_CONTACT_EMAIL=
# Minimum milliseconds between requests to the same marketplace (default 8000, plus jitter).
DEALS_MIN_INTERVAL_MS=
# Chromium for the browser-based deal sources. Not needed in the Docker image or after
# `pnpm exec playwright-core install chromium`; set it to use a Chrome/Chromium you already have.
PLAYWRIGHT_CHROMIUM_PATH=

# --- Newsletter -------------------------------------------------------------------
# Resend → Webhooks → add endpoint https://<your-domain>/newsletter/resend-webhook
# (events: delivered, opened, clicked, bounced, complained) and paste its signing secret here.
RESEND_WEBHOOK_SECRET=

# --- Monitoring & statistics -------------------------------------------------------
# Sentry error reporting (server errors + failed background jobs). Empty = off.
SENTRY_DSN=
# Privacy-friendly visitor stats, no cookies. Set ONE of these (empty = off):
PLAUSIBLE_DOMAIN=
# PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.outbound-links.js   (self-hosted: your own URL)
UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# --- Instant alerts & channels ---------------------------------------------------------
# Personal push for deal alerts and paused sources. Telegram: create a bot with @BotFather,
# send it a message, then get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy (https://ntfy.sh app on your phone): pick a long random topic name. NTFY_TOKEN only for protected topics.
NTFY_URL=
NTFY_TOKEN=
# Geocoder for deal distances (default: OpenStreetMap Nominatim, max 1 request/s, results cached).
GEOCODER_URL=
# Community channels for new firmware releases (posted within 48h of release):
DISCORD_WEBHOOK_URL=
# Telegram channel (add the TELEGRAM_BOT_TOKEN bot as admin), e.g. @fpvnews or -100123456789
TELEGRAM_CHANNEL_ID=
